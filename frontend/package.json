{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,docs \"vite --port 5173 --strictPort\" \"vitepress dev docs --port 5174 --strictPort\"",
    "dev:app": "vite --port 5173 --strictPort",
    "docs:dev": "vitepress dev docs --port 5174 --strictPort",
    "build": "vue-tsc -b && vite build && vitepress build docs",
    "docs:build": "vitepress build docs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@antv/hierarchy": "^0.7.1",
    "@antv/x6": "^2.19.2",
    "@antv/x6-plugin-dnd": "^2.1.1",
    "@antv/x6-vue-shape": "^2.1.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@mdit/plugin-katex": "^0.21.0",
    "dompurify": "^3.4.8",
    "element-plus": "^2.13.2",
    "katex": "^0.16.22",
    "markdown-it": "^14.2.0",
    "sass": "^1.97.3",
    "vue": "^3.5.24",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.1.4"
  }
}
